<Application x:Class="Wysicraft.Designer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#25282E"/>
  <!-- Native popup menus use a light background; do not inherit the dark
       menu bar's white foreground into their items. Applies to context menus too. -->
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="#20242B"/>
   <Style.Triggers>
    <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Foreground" Value="#E2E6ED"/></Trigger>
    <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Foreground" Value="#E2E6ED"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#111111"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#777777"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="Window"><Setter Property="Background" Value="#1D2025"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#181B20"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="BorderBrush" Value="#454B56"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="2"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#394352"/><Setter Property="Foreground" Value="#E2E6ED"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#697382" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#475B70"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#176282"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#25282E"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="BorderBrush" Value="#454B56"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#25282E"/><Setter Property="BorderBrush" Value="#454B56"/></Style>
 </Application.Resources>
</Application>
