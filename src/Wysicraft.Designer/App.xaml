<Application x:Class="Wysicraft.Designer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#25282E"/>
  <!-- Native popup menus use a light background; do not inherit the dark
       menu bar's white foreground into their items. Applies to context menus too. -->
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="#20242B"/>
   <Style.Triggers>
    <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Foreground" Value="#E2E6ED"/></Trigger>
    <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Foreground" Value="#E2E6ED"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#111111"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#777777"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="Window"><Setter Property="Background" Value="#1D2025"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#181B20"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="BorderBrush" Value="#454B56"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="2"/></Style>
  <!-- Standard button: soft rounded chrome in the VS dark palette. Background can be overridden (e.g. the MCP accent). -->
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#333A45"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="BorderBrush" Value="#4A5261"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="Hover" CornerRadius="3" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#6C7686"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.16"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3794FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Borderless icon button for list rows (Layers eye/lock, group expanders). -->
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Padding" Value="3,1"/><Setter Property="Margin" Value="1,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3A4250"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#25282E"/><Setter Property="Foreground" Value="#E2E6ED"/><Setter Property="BorderBrush" Value="#454B56"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#25282E"/><Setter Property="BorderBrush" Value="#454B56"/></Style>
 </Application.Resources>
</Application>
